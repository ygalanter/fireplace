{
  "name": "fireplace",
  "author": "yuri@galanter.net",
  "version": "2.0.0",
  "description": "Pebble watchface showing flames through time digits",
  "keywords": [
    "pebble-app",
    "watchface"
  ],
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "Fireplace",
    "uuid": "10e8255b-96ae-47c1-82af-b70b943ba7ed",
    "sdkVersion": "3",
    "projectType": "native",
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "BACKLIGHT",
      "SOUND"
    ],
    "resources": {
